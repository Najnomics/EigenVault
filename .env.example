# EigenVault Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# Ethereum Mainnet
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MAINNET_CHAIN_ID=1

# Holesky Testnet (EigenLayer testnet)
HOLESKY_RPC_URL=https://holesky.infura.io/v3/YOUR_INFURA_KEY
HOLESKY_CHAIN_ID=17000

# Sepolia Testnet
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
SEPOLIA_CHAIN_ID=11155111

# Local Anvil Development
ANVIL_RPC_URL=http://localhost:8545
ANVIL_CHAIN_ID=31337

# =============================================================================
# DEPLOYMENT KEYS
# =============================================================================

# Deployer Private Key (DO NOT USE MAINNET KEYS)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Operator Private Key (for AVS operations)
OPERATOR_PRIVATE_KEY=0x...

# Additional Test Accounts
TEST_ACCOUNT_1_PRIVATE_KEY=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
TEST_ACCOUNT_2_PRIVATE_KEY=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# =============================================================================
# EIGENLAYER CONFIGURATION
# =============================================================================

# EigenLayer RPC URLs
EIGENLAYER_HOLESKY_RPC_URL=https://holesky.eigenda.xyz
EIGENLAYER_MAINNET_RPC_URL=https://api.eigenlayer.xyz

# AVS Configuration
AVS_NAME=EigenVault
AVS_METADATA_URI=https://your-domain.com/metadata.json
AVS_QUORUM_THRESHOLD=2
AVS_QUORUM_SIZE=3

# =============================================================================
# CONTRACT ADDRESSES (Auto-populated after deployment)
# =============================================================================

# Mainnet Addresses
MAINNET_ORDER_VAULT_ADDRESS=0x...
MAINNET_EIGENVAULT_HOOK_ADDRESS=0x...
MAINNET_AVS_SERVICE_MANAGER_ADDRESS=0x...

# Holesky Addresses
HOLESKY_ORDER_VAULT_ADDRESS=0x...
HOLESKY_EIGENVAULT_HOOK_ADDRESS=0x...
HOLESKY_AVS_SERVICE_MANAGER_ADDRESS=0x...

# =============================================================================
# VERIFICATION & EXPLORERS
# =============================================================================

# Etherscan API Keys
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
HOLESKY_ETHERSCAN_API_KEY=YOUR_HOLESKY_ETHERSCAN_API_KEY

# =============================================================================
# OPERATOR CONFIGURATION
# =============================================================================

# Operator Node Configuration
OPERATOR_RPC_URL=http://localhost:8545
OPERATOR_LISTEN_PORT=9000
OPERATOR_MAX_PENDING_ORDERS=1000

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# Grafana
GRAFANA_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Access Control
ADMIN_ADDRESS=0x...
EMERGENCY_PAUSE_ADDRESS=0x...

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Alchemy (for enhanced RPC)
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY

# Infura (backup RPC)
INFURA_PROJECT_ID=YOUR_INFURA_PROJECT_ID
