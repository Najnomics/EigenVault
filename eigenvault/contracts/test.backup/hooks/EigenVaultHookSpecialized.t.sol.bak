    /// Test 138: Block timestamp edge cases
    function test_EdgeCases_BlockTimestampEdgeCases() public {
        // Test at block timestamp 0
        vm.warp(0);
        
        SwapParams memory params = _createValidSwapParams(-1000e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        assertTrue(orderId != bytes32(0));
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertEq(order.deadline, DEFAULT_DEADLINE);
