    /// Test 139: Maximum block timestamp
    function test_EdgeCases_MaxBlockTimestamp() public {
        // Test at maximum timestamp
        vm.warp(type(uint32).max);
        
        SwapParams memory params = _createValidSwapParams(-1000e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        assertTrue(orderId != bytes32(0));
    }
    
    /// Test 140: Order ID collision prevention
    function test_EdgeCases_OrderIdCollisionPrevention() public {
        bytes32[] memory orderIds = new bytes32[](100);
        
        // Create many orders to test for collisions
        for (uint i = 0; i < 100; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i), true);
            orderIds[i] = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        }
        
        // Verify all IDs are unique
        for (uint i = 0; i < 100; i++) {
            for (uint j = i + 1; j < 100; j++) {
                assertTrue(orderIds[i] != orderIds[j]);
            }
        }
    }

    // ============ Integration and End-to-End Tests (Tests 141-150) ============
    
    /// Test 141: Complete order lifecycle integration
    function test_Integration_CompleteOrderLifecycle() public {
        // Create order
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Verify order created
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertEq(order.trader, TRADER);
        assertFalse(order.executed);
        
        // Execute with ZK proof
        bytes memory zkProof = _createZKProof();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        
        // Verify execution
        order = hook.getOrder(orderId);
        assertTrue(order.executed);
    }
    
    /// Test 142: Multi-pool integration
    function test_Integration_MultiPoolIntegration() public {
        // Create multiple pools
        PoolKey memory pool1 = defaultPoolKey;
        PoolKey memory pool2 = PoolKey({
            currency0: Currency.wrap(address(0x3000)),
            currency1: Currency.wrap(address(0x4000)),
            fee: 3000,
            tickSpacing: 60,
            hooks: IHooks(address(hook))
        });
        PoolKey memory pool3 = PoolKey({
            currency0: Currency.wrap(address(0x5000)),
            currency1: Currency.wrap(address(0x6000)),
            fee: 3000,
            tickSpacing: 60,
            hooks: IHooks(address(hook))
        });
        
        // Create orders in each pool
        SwapParams memory params1 = _createValidSwapParams(-1000e18, true);
        SwapParams memory params2 = _createValidSwapParams(-1100e18, false);
        SwapParams memory params3 = _createValidSwapParams(-1200e18, true);
        
        bytes32 orderId1 = hook.routeToVault(TRADER, pool1, params1, "");
        bytes32 orderId2 = hook.routeToVault(TRADER, pool2, params2, "");
        bytes32 orderId3 = hook.routeToVault(TRADER, pool3, params3, "");
        
        // Verify all orders created
        assertTrue(orderId1 != bytes32(0));
        assertTrue(orderId2 != bytes32(0));
        assertTrue(orderId3 != bytes32(0));
    }
    
    /// Test 143: Cross-chain compatibility simulation
    function test_Integration_CrossChainCompatibility() public {
        // Simulate different chain IDs
        vm.chainId(1); // Ethereum mainnet
        
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId1 = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        vm.chainId(42161); // Arbitrum
        
        bytes32 orderId2 = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        assertTrue(orderId1 != bytes32(0));
        assertTrue(orderId2 != bytes32(0));
    }
    
    /// Test 144: Emergency scenarios integration
    function test_Integration_EmergencyScenarios() public {
        // Create order
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Activate emergency pause
        vm.prank(OWNER);
        hook.activateEmergencyPause("Critical security issue");
        
        // Verify order can't be executed during pause
        bytes memory zkProof = _createZKProof();
        vm.expectRevert();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        
        // Deactivate and verify execution works
        vm.prank(OWNER);
        hook.deactivateEmergencyPause();
        
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertTrue(order.executed);
    }
    
    /// Test 145: Governance integration
    function test_Integration_GovernanceIntegration() public {
        // Test ownership transfer
        address newOwner = address(0x9999);
        
        vm.prank(OWNER);
        hook.transferOwnership(newOwner);
        
        vm.prank(newOwner);
        hook.acceptOwnership();
        
        // Verify new owner can update settings
        vm.prank(newOwner);
        hook.setVaultThreshold(25);
        
        assertEq(hook.vaultThresholdBps(), 25);
    }
    
    /// Test 146: Gas optimization integration
    function test_Integration_GasOptimizationIntegration() public {
        // Enable gas optimizations
        vm.prank(OWNER);
        hook.updateGasOptimization(true, 20, true);
        
        // Create multiple orders for batch processing
        bytes32[] memory orderIds = new bytes32[](5);
        for (uint i = 0; i < 5; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 100e18), true);
            orderIds[i] = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        }
        
        // Test batch processing
        uint256 successCount = hook.batchProcessOrders(orderIds);
        assertEq(successCount, 5);
    }
    
    /// Test 147: Statistics and monitoring integration
    function test_Integration_StatisticsMonitoringIntegration() public {
        // Create and execute multiple orders
        for (uint i = 0; i < 10; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 50e18), i % 2 == 0);
            bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
            
            if (i < 5) {
                bytes memory zkProof = _createZKProof();
                vm.prank(address(avsServiceManager));
                hook.executeMatchedOrder(orderId, zkProof);
            }
        }
        
        // Verify statistics
        EigenVaultHook.ExecutionStats memory stats = hook.getPoolStats(defaultPoolId);
        assertEq(stats.totalOrders, 10);
        assertEq(stats.successfulMatches, 5);
    }
    
    /// Test 148: Upgrade compatibility simulation
    function test_Integration_UpgradeCompatibilitySimulation() public {
        // Create orders with current version
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Simulate upgrade by changing configuration
        vm.prank(OWNER);
        hook.updateSecurityConfig(20000e18, 200000e18, 1000);
        
        // Verify existing orders still work
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertEq(order.trader, TRADER);
        
        // Verify new orders work with new config
        SwapParams memory newParams = _createValidSwapParams(-25000e18, true);
        vm.expectRevert(); // Should fail due to security limits
        hook.routeToVault(WHALE, defaultPoolKey, newParams, "");
    }
    
    /// Test 149: Load balancing simulation
    function test_Integration_LoadBalancingSimulation() public {
        // Create orders across multiple pools to simulate load balancing
        PoolKey[] memory pools = new PoolKey[](3);
        pools[0] = defaultPoolKey;
        pools[1] = PoolKey({
            currency0: Currency.wrap(address(0x7000)),
            currency1: Currency.wrap(address(0x8000)),
            fee: 3000,
            tickSpacing: 60,
            hooks: IHooks(address(hook))
        });
        pools[2] = PoolKey({
            currency0: Currency.wrap(address(0x9000)),
            currency1: Currency.wrap(address(0xA000)),
            fee: 3000,
            tickSpacing: 60,
            hooks: IHooks(address(hook))
        });
        
        // Distribute orders across pools
        for (uint i = 0; i < 30; i++) {
            PoolKey memory selectedPool = pools[i % 3];
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 50e18), i % 2 == 0);
            bytes32 orderId = hook.routeToVault(TRADER, selectedPool, params, "");
            assertTrue(orderId != bytes32(0));
        }
        
        // Verify distribution
        bytes32 poolId0 = PoolId.unwrap(pools[0].toId());
        bytes32 poolId1 = PoolId.unwrap(pools[1].toId());
        bytes32 poolId2 = PoolId.unwrap(pools[2].toId());
        
        assertEq(hook.poolOrderCounts(poolId0), 10);
        assertEq(hook.poolOrderCounts(poolId1), 10);
        assertEq(hook.poolOrderCounts(poolId2), 10);
    }
    
    /// Test 150: Complete system validation and health check
    function test_Integration_CompleteSystemValidationHealthCheck() public {
        // Create comprehensive system test
        
        // 1. Basic functionality
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        assertTrue(orderId != bytes32(0));
        
        // 2. Security features
        vm.prank(OWNER);
        hook.updateSecurityConfig(15000e18, 150000e18, 750);
        
        // 3. Gas optimization
        vm.prank(OWNER);
        hook.updateGasOptimization(true, 15, true);
        
        // 4. Emergency controls
        vm.prank(OWNER);
        hook.activateEmergencyPause("System health check");
        vm.prank(OWNER);
        hook.deactivateEmergencyPause();
        
        // 5. Order execution
        bytes memory zkProof = _createZKProof();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        
        // 6. Statistics verification
        EigenVaultHook.ExecutionStats memory stats = hook.getPoolStats(defaultPoolId);
        assertEq(stats.totalOrders, 1);
        assertEq(stats.successfulMatches, 1);
        
        // 7. State consistency
        assertEq(hook.orderNonce(), 1);
        assertEq(hook.poolOrderCounts(defaultPoolId), 1);
        
        // 8. Final verification
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertTrue(order.executed);
        assertEq(order.trader, TRADER);
        
        // System health check passed!
        assertTrue(true);
    }
}

// ============ Mock Contracts ============

contract MockPoolManager {
    uint256 public testValue = 12345;
    
    function swap(PoolKey calldata, SwapParams calldata, bytes calldata) 
        external pure returns (BalanceDelta delta) {
        return BalanceDelta.wrap(0);
    }
}

contract MockOrderVault {
    bool public storeOrderCalled;
    bytes32 public lastOrderId;
    uint256 public lastAmount;
    
    function storeOrder(
        bytes32 orderId,
        uint256 amount,
        bool,
        uint256,
        uint256,
        address,
        bytes32,
        bytes32
    ) external {
        storeOrderCalled = true;
        lastOrderId = orderId;
        lastAmount = amount;
    }
}

contract MockEigenVaultAVS {
    bool public createMatchingTaskCalled;
    
    function createMatchingTask(bytes32, bytes32, bytes32) external pure returns (uint32) {
        return 0;
    }
    
    function getAssignedOperators(bytes32) external pure returns (address[] memory) {
        address[] memory operators = new address[](2);
        operators[0] = address(0xDEF0);
        operators[1] = address(0xDEF1);
        return operators;
    }
    
    function requestConsensus(bytes32, bytes32) external {
        createMatchingTaskCalled = true;
    }
}