// SPDX-License-Identifier: MIT
pragma solidity ^0.8.26;

import {Test, console} from "forge-std/Test.sol";
import {Vm} from "forge-std/Vm.sol";
import {IPoolManager} from "@uniswap/v4-core/src/interfaces/IPoolManager.sol";
import {IHooks} from "@uniswap/v4-core/src/interfaces/IHooks.sol";
import {PoolKey} from "@uniswap/v4-core/src/types/PoolKey.sol";
import {PoolId, PoolIdLibrary} from "@uniswap/v4-core/src/types/PoolId.sol";
import {Currency, CurrencyLibrary} from "@uniswap/v4-core/src/types/Currency.sol";
import {SwapParams} from "@uniswap/v4-core/src/types/PoolOperation.sol";
import {BalanceDelta} from "@uniswap/v4-core/src/types/BalanceDelta.sol";
import {Hooks} from "@uniswap/v4-core/src/libraries/Hooks.sol";

import {EigenVaultHook} from "../../src/hooks/EigenVaultHook.sol";
import {IEigenVaultHook} from "../../src/hooks/IEigenVaultHook.sol";
import {OrderMatchingLib} from "../../src/vault/OrderMatchingLib.sol";

/// @title EigenVault Hook Specialized Tests (Tests 101-150)
/// @notice Specialized tests for complex scenarios, stress testing, and edge cases
contract EigenVaultHookSpecializedTest is Test {
    using PoolIdLibrary for PoolKey;
    using CurrencyLibrary for Currency;

    // ============ Test Contracts ============
    EigenVaultHook public hook;
    MockPoolManager public poolManager;
    MockOrderVault public orderVault;
    MockEigenVaultAVS public avsServiceManager;
    
    // ============ Test Data ============
    Currency public constant currency0 = Currency.wrap(address(0x1000));
    Currency public constant currency1 = Currency.wrap(address(0x2000));
    uint24 public constant fee = 3000;
    int24 public constant tickSpacing = 60;
    
    PoolKey public defaultPoolKey;
    bytes32 public defaultPoolId;
    
    // Test addresses
    address public constant TRADER = address(0x1234);
    address public constant OWNER = address(0x5678);
    address public constant UNAUTHORIZED = address(0x9ABC);
    address public constant OPERATOR1 = address(0xDEF0);
    address public constant OPERATOR2 = address(0xDEF1);
    address public constant WHALE = address(0x1111);
    
    // Default test amounts
    uint256 public constant SMALL_AMOUNT = 100e18;
    uint256 public constant LARGE_AMOUNT = 10000e18;
    uint256 public constant HUGE_AMOUNT = 100000e18;
    uint256 public constant DEFAULT_DEADLINE = 1 hours;
    uint256 public constant DEFAULT_THRESHOLD = 10; // 0.1%
    
    // ============ Events for Testing ============
    event OrderRoutedToVault(address indexed trader, bytes32 indexed orderId, PoolKey indexed key, bool zeroForOne, int256 amountSpecified, bytes32 commitment);
    event VaultOrderExecuted(PoolKey indexed poolKey, uint256 amountIn, uint256 expectedAmountOut, uint256 actualAmount0, uint256 actualAmount1, bool zeroForOne);
    event SecurityConfigUpdated(uint256 maxOrderSize, uint256 maxPoolExposure, uint256 maxSlippageBps);
    event GasOptimizationUpdated(bool batchProcessing, uint256 maxBatchSize, bool compression);
    event AVSServiceManagerAuthorized(address indexed avsServiceManager, bool authorized);
    event EmergencyPauseActivated(string reason, uint256 timestamp);
    event EmergencyPauseDeactivated(uint256 timestamp);
    event BatchProcessCompleted(uint256 totalOrders, uint256 successCount);
    event SecurityCheckFailed(bytes32 indexed orderId, uint256 riskScore, string reason);
    event OrderMatched(bytes32 indexed orderId, address indexed trader, uint256 executionPrice, uint256 matchedAmount);
    event LiquidityChecked(bytes32 indexed poolId, uint256 requiredAmount, uint256 availableLiquidity, bool sufficient);
    
    function setUp() public {
        // Deploy mock contracts
        poolManager = new MockPoolManager();
        orderVault = new MockOrderVault();
        avsServiceManager = new MockEigenVaultAVS();
        
        // Deploy the hook
        vm.prank(OWNER);
        hook = new EigenVaultHook(
            IPoolManager(address(poolManager)),
            address(orderVault),
            address(avsServiceManager)
        );
        
        // Setup default pool key
        defaultPoolKey = PoolKey({
            currency0: currency0,
            currency1: currency1,
            fee: fee,
            tickSpacing: tickSpacing,
            hooks: IHooks(address(hook))
        });
        defaultPoolId = PoolId.unwrap(defaultPoolKey.toId());
        
        // Setup initial balances
        _setupBalances();
        
        // Label addresses for better trace output
        vm.label(address(hook), "EigenVaultHook");
        vm.label(address(poolManager), "MockPoolManager");
        vm.label(address(orderVault), "MockOrderVault");
        vm.label(address(avsServiceManager), "MockAVS");
        vm.label(TRADER, "Trader");
        vm.label(OWNER, "Owner");
        vm.label(UNAUTHORIZED, "Unauthorized");
        vm.label(WHALE, "Whale");
    }

    // ============ Helper Functions ============
    
    function _setupBalances() internal {
        vm.deal(TRADER, 1000 ether);
        vm.deal(OWNER, 1000 ether);
        vm.deal(UNAUTHORIZED, 1000 ether);
        vm.deal(WHALE, 10000 ether);
        vm.deal(address(hook), 1000 ether);
        vm.deal(OPERATOR1, 1000 ether);
        vm.deal(OPERATOR2, 1000 ether);
    }
    
    function _createValidSwapParams(int256 amountSpecified, bool zeroForOne) internal pure returns (SwapParams memory) {
        return SwapParams({
            zeroForOne: zeroForOne,
            amountSpecified: amountSpecified,
            sqrtPriceLimitX96: zeroForOne ? 4295128739 : 1461446703485210103287273052203988822378723970341
        });
    }
    
    function _createZKProof() internal view returns (bytes memory) {
        bytes32 proofId = keccak256("test_proof");
        bytes memory proofData = abi.encode("mock_proof_data");
        bytes32[] memory publicInputs = new bytes32[](2);
        publicInputs[0] = bytes32(uint256(123));
        publicInputs[1] = bytes32(uint256(456));
        bytes memory verificationKey = abi.encode("mock_verification_key");
        uint256 timestamp = block.timestamp;
        address[] memory operators = new address[](2);
        operators[0] = OPERATOR1;
        operators[1] = OPERATOR2;
        
        return abi.encode(proofId, proofData, publicInputs, verificationKey, timestamp, operators);
    }
    
    function _skipToExpiry(uint256 orderDeadline) internal {
        vm.warp(orderDeadline + 1);
    }

    // ============ MEV Protection Tests (Tests 101-110) ============
    
    /// Test 101: MEV sandwich attack detection
    function test_MEVProtection_SandwichAttackDetection() public {
        hook.setLargeOrderThreshold(1000e18);
        
        // Simulate front-running attempt
        SwapParams memory frontrunParams = _createValidSwapParams(-500e18, true);
        hook.routeToVault(address(0x8888), defaultPoolKey, frontrunParams, "");
        
        // Large order should be protected
        SwapParams memory largeParams = _createValidSwapParams(-2000e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, largeParams, "");
        
        assertTrue(orderId != bytes32(0));
    }
    
    /// Test 102: Front-running detection algorithm
    function test_MEVProtection_FrontRunningDetection() public {
        // Setup threshold for detection
        vm.prank(OWNER);
        hook.setVaultThreshold(50); // 0.5%
        
        // Simulate suspicious pattern
        for (uint i = 0; i < 3; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 100e18), true);
            hook.routeToVault(address(uint160(0x7000 + i)), defaultPoolKey, params, "");
        }
        
        assertEq(hook.poolOrderCounts(defaultPoolId), 3);
    }
    
    /// Test 103: Time-based MEV protection
    function test_MEVProtection_TimeBasedProtection() public {
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Advance time and verify protection is maintained
        vm.warp(block.timestamp + 30 minutes);
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertTrue(order.deadline > block.timestamp);
    }
    
    /// Test 104: Multi-block MEV protection
    function test_MEVProtection_MultiBlockProtection() public {
        SwapParams memory params = _createValidSwapParams(-2000e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Simulate multiple blocks
        vm.roll(block.number + 3);
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertFalse(order.executed);
    }
    
    /// Test 105: Price manipulation detection
    function test_MEVProtection_PriceManipulationDetection() public {
        // Create order with extreme price impact
        SwapParams memory params = _createValidSwapParams(-50000e18, true);
        bytes32 orderId = hook.routeToVault(WHALE, defaultPoolKey, params, "");
        
        assertTrue(orderId != bytes32(0));
        
        // Check that large order was routed to vault for protection
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertTrue(order.amount == 50000e18);
    }
    
    /// Test 106: Back-running protection mechanism
    function test_MEVProtection_BackRunningProtection() public {
        SwapParams memory params = _createValidSwapParams(-1800e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Execute order with ZK proof
        bytes memory zkProof = _createZKProof();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        
        // Verify execution was successful
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertTrue(order.executed);
    }
    
    /// Test 107: Cross-pool MEV protection
    function test_MEVProtection_CrossPoolProtection() public {
        // Create second pool
        PoolKey memory pool2 = PoolKey({
            currency0: Currency.wrap(address(0x3000)),
            currency1: Currency.wrap(address(0x4000)),
            fee: fee,
            tickSpacing: tickSpacing,
            hooks: IHooks(address(hook))
        });
        
        SwapParams memory params1 = _createValidSwapParams(-1500e18, true);
        SwapParams memory params2 = _createValidSwapParams(-1600e18, false);
        
        bytes32 order1 = hook.routeToVault(TRADER, defaultPoolKey, params1, "");
        bytes32 order2 = hook.routeToVault(TRADER, pool2, params2, "");
        
        assertTrue(order1 != bytes32(0));
        assertTrue(order2 != bytes32(0));
    }
    
    /// Test 108: MEV protection threshold adjustment
    function test_MEVProtection_ThresholdAdjustment() public {
        vm.prank(OWNER);
        hook.setVaultThreshold(5); // 0.05%
        
        SwapParams memory params = _createValidSwapParams(-800e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        assertTrue(hook.isLargeOrder(-800e18, defaultPoolKey));
        assertTrue(orderId != bytes32(0));
    }
    
    /// Test 109: MEV protection gas efficiency
    function test_MEVProtection_GasEfficiency() public {
        uint256 gasBefore = gasleft();
        
        SwapParams memory params = _createValidSwapParams(-1200e18, true);
        hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        uint256 gasUsed = gasBefore - gasleft();
        assertLt(gasUsed, 200000); // Should be reasonably efficient
    }
    
    /// Test 110: MEV protection state consistency
    function test_MEVProtection_StateConsistency() public {
        SwapParams memory params = _createValidSwapParams(-1400e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Verify state is consistent
        assertTrue(hook.poolOrderCounts(defaultPoolId) == 1);
        assertTrue(hook.poolTotalVolumes(defaultPoolId) == 1400e18);
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertEq(order.trader, TRADER);
        assertEq(order.amount, 1400e18);
    }

    // ============ ZK Proof Validation Tests (Tests 111-120) ============
    
    /// Test 111: Valid ZK proof structure validation
    function test_ZKProofValidation_ValidStructure() public {
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        bytes memory zkProof = _createZKProof();
        
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertTrue(order.executed);
    }
    
    /// Test 112: Invalid ZK proof rejection
    function test_ZKProofValidation_InvalidProofRejection() public {
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        bytes memory invalidProof = abi.encode("invalid_proof");
        
        vm.expectRevert();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, invalidProof);
    }
    
    /// Test 113: ZK proof timestamp validation
    function test_ZKProofValidation_TimestampValidation() public {
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Create proof with future timestamp
        bytes memory futureProof = abi.encode(
            keccak256("proof"),
            abi.encode("data"),
            new bytes32[](2),
            abi.encode("key"),
            block.timestamp + 1 hours,
            new address[](2)
        );
        
        vm.expectRevert();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, futureProof);
    }
    
    /// Test 114: ZK proof operator validation
    function test_ZKProofValidation_OperatorValidation() public {
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        bytes memory zkProof = _createZKProof();
        
        // Should succeed with authorized AVS
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertTrue(order.executed);
    }
    
    /// Test 115: ZK proof replay protection
    function test_ZKProofValidation_ReplayProtection() public {
        SwapParams memory params1 = _createValidSwapParams(-1500e18, true);
        SwapParams memory params2 = _createValidSwapParams(-1600e18, true);
        
        bytes32 orderId1 = hook.routeToVault(TRADER, defaultPoolKey, params1, "");
        bytes32 orderId2 = hook.routeToVault(TRADER, defaultPoolKey, params2, "");
        
        bytes memory zkProof = _createZKProof();
        
        // Execute first order
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId1, zkProof);
        
        // Attempt to use same proof for second order should fail
        vm.expectRevert();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId2, zkProof);
    }
    
    /// Test 116: ZK proof public input validation
    function test_ZKProofValidation_PublicInputValidation() public {
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Create proof with invalid public inputs
        bytes32[] memory invalidInputs = new bytes32[](1); // Wrong length
        bytes memory invalidProof = abi.encode(
            keccak256("proof"),
            abi.encode("data"),
            invalidInputs,
            abi.encode("key"),
            block.timestamp,
            new address[](2)
        );
        
        vm.expectRevert();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, invalidProof);
    }
    
    /// Test 117: ZK proof verification key validation
    function test_ZKProofValidation_VerificationKeyValidation() public {
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        bytes memory zkProof = _createZKProof();
        
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        
        // Proof should be accepted with valid key
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertTrue(order.executed);
    }
    
    /// Test 118: ZK proof size limits
    function test_ZKProofValidation_SizeLimits() public {
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Create oversized proof
        bytes memory largeData = new bytes(10000);
        bytes memory oversizedProof = abi.encode(
            keccak256("proof"),
            largeData,
            new bytes32[](2),
            abi.encode("key"),
            block.timestamp,
            new address[](2)
        );
        
        vm.expectRevert();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, oversizedProof);
    }
    
    /// Test 119: ZK proof batch validation
    function test_ZKProofValidation_BatchValidation() public {
        bytes32[] memory orderIds = new bytes32[](3);
        
        for (uint i = 0; i < 3; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1500e18 + i * 100e18), true);
            orderIds[i] = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        }
        
        // Execute all orders with valid proofs
        for (uint i = 0; i < 3; i++) {
            bytes memory zkProof = _createZKProof();
            vm.prank(address(avsServiceManager));
            hook.executeMatchedOrder(orderIds[i], zkProof);
        }
        
        // Verify all executed
        for (uint i = 0; i < 3; i++) {
            IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderIds[i]);
            assertTrue(order.executed);
        }
    }
    
    /// Test 120: ZK proof performance benchmarking
    function test_ZKProofValidation_PerformanceBenchmark() public {
        SwapParams memory params = _createValidSwapParams(-1500e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        bytes memory zkProof = _createZKProof();
        
        uint256 gasBefore = gasleft();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        uint256 gasUsed = gasBefore - gasleft();
        
        // Should be efficient
        assertLt(gasUsed, 150000);
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertTrue(order.executed);
    }

    // ============ Stress Testing (Tests 121-130) ============
    
    /// Test 121: High volume order processing
    function test_StressTesting_HighVolumeOrderProcessing() public {
        uint256 orderCount = 100;
        
        for (uint256 i = 0; i < orderCount; i++) {
            address trader = address(uint160(0x5000 + i));
            vm.deal(trader, 100 ether);
            
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 10e18), i % 2 == 0);
            hook.routeToVault(trader, defaultPoolKey, params, "");
        }
        
        assertEq(hook.orderNonce(), orderCount);
        assertEq(hook.poolOrderCounts(defaultPoolId), orderCount);
    }
    
    /// Test 122: Concurrent order execution
    function test_StressTesting_ConcurrentOrderExecution() public {
        bytes32[] memory orderIds = new bytes32[](10);
        
        // Create multiple orders
        for (uint i = 0; i < 10; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1500e18 + i * 50e18), true);
            orderIds[i] = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        }
        
        // Execute all simultaneously
        for (uint i = 0; i < 10; i++) {
            bytes memory zkProof = _createZKProof();
            vm.prank(address(avsServiceManager));
            hook.executeMatchedOrder(orderIds[i], zkProof);
        }
        
        // Verify all executed
        for (uint i = 0; i < 10; i++) {
            IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderIds[i]);
            assertTrue(order.executed);
        }
    }
    
    /// Test 123: Memory usage optimization
    function test_StressTesting_MemoryUsageOptimization() public {
        // Create many orders to test memory efficiency
        for (uint256 i = 0; i < 50; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 20e18), true);
            bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
            
            // Verify each order is stored efficiently
            IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
            assertEq(order.amount, 1000e18 + i * 20e18);
        }
    }
    
    /// Test 124: Gas limit stress testing
    function test_StressTesting_GasLimitStressTest() public {
        uint256 gasBefore = gasleft();
        
        // Perform multiple operations
        SwapParams memory params = _createValidSwapParams(-2000e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        bytes memory zkProof = _createZKProof();
        vm.prank(address(avsServiceManager));
        hook.executeMatchedOrder(orderId, zkProof);
        
        uint256 gasUsed = gasBefore - gasleft();
        assertLt(gasUsed, 400000); // Should be within reasonable limits
    }
    
    /// Test 125: Network congestion simulation
    function test_StressTesting_NetworkCongestionSimulation() public {
        // Simulate high gas prices
        vm.txGasPrice(100 gwei);
        
        SwapParams memory params = _createValidSwapParams(-1800e18, true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        // Order should still be processed efficiently
        assertTrue(orderId != bytes32(0));
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertEq(order.trader, TRADER);
    }
    
    /// Test 126: Storage slot optimization
    function test_StressTesting_StorageSlotOptimization() public {
        // Test efficient storage usage
        uint256 orderCount = 20;
        
        for (uint256 i = 0; i < orderCount; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 50e18), true);
            bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
            
            // Verify storage efficiency
            assertTrue(orderId != bytes32(0));
        }
        
        assertEq(hook.orderNonce(), orderCount);
    }
    
    /// Test 127: Batch processing limits
    function test_StressTesting_BatchProcessingLimits() public {
        // Test maximum batch size
        bytes32[] memory orderIds = new bytes32[](10);
        
        for (uint i = 0; i < 10; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 100e18), true);
            orderIds[i] = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        }
        
        uint256 successCount = hook.batchProcessOrders(orderIds);
        assertEq(successCount, 10);
    }
    
    /// Test 128: Order expiration handling under load
    function test_StressTesting_OrderExpirationUnderLoad() public {
        bytes32[] memory orderIds = new bytes32[](20);
        
        // Create multiple orders
        for (uint i = 0; i < 20; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 25e18), true);
            orderIds[i] = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        }
        
        // Skip to expiry
        vm.warp(block.timestamp + 2 hours);
        
        // Process expired orders
        for (uint i = 0; i < 20; i++) {
            hook.fallbackToAMM(orderIds[i]);
        }
    }
    
    /// Test 129: State consistency under stress
    function test_StressTesting_StateConsistencyUnderStress() public {
        uint256 initialNonce = hook.orderNonce();
        uint256 initialPoolCount = hook.poolOrderCounts(defaultPoolId);
        
        // Perform many operations
        for (uint i = 0; i < 30; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1000e18 + i * 30e18), i % 2 == 0);
            hook.routeToVault(TRADER, defaultPoolKey, params, "");
        }
        
        // Verify state consistency
        assertEq(hook.orderNonce(), initialNonce + 30);
        assertEq(hook.poolOrderCounts(defaultPoolId), initialPoolCount + 30);
    }
    
    /// Test 130: Recovery from failures
    function test_StressTesting_RecoveryFromFailures() public {
        // Create orders
        bytes32[] memory orderIds = new bytes32[](5);
        for (uint i = 0; i < 5; i++) {
            SwapParams memory params = _createValidSwapParams(-int256(1500e18 + i * 100e18), true);
            orderIds[i] = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        }
        
        // Simulate partial failures and recovery
        for (uint i = 0; i < 3; i++) {
            bytes memory zkProof = _createZKProof();
            vm.prank(address(avsServiceManager));
            hook.executeMatchedOrder(orderIds[i], zkProof);
        }
        
        // Verify system can continue operating
        SwapParams memory newParams = _createValidSwapParams(-2000e18, true);
        bytes32 newOrderId = hook.routeToVault(TRADER, defaultPoolKey, newParams, "");
        assertTrue(newOrderId != bytes32(0));
    }

    // ============ Edge Cases and Corner Cases (Tests 131-140) ============
    
    /// Test 131: Zero amount order handling
    function test_EdgeCases_ZeroAmountOrder() public {
        SwapParams memory params = _createValidSwapParams(0, true);
        
        vm.expectRevert();
        hook.routeToVault(TRADER, defaultPoolKey, params, "");
    }
    
    /// Test 132: Maximum uint256 amount handling
    function test_EdgeCases_MaxUint256Amount() public {
        SwapParams memory params = _createValidSwapParams(int256(uint256(type(uint128).max)), true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        assertTrue(orderId != bytes32(0));
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertEq(order.amount, uint256(type(uint128).max));
    }
    
    /// Test 133: Minimum int256 amount handling
    function test_EdgeCases_MinInt256Amount() public {
        SwapParams memory params = _createValidSwapParams(-int256(uint256(type(uint128).max)), true);
        bytes32 orderId = hook.routeToVault(TRADER, defaultPoolKey, params, "");
        
        assertTrue(orderId != bytes32(0));
        
        IEigenVaultHook.PrivateOrder memory order = hook.getOrder(orderId);
        assertEq(order.amount, uint256(type(uint128).max));
    }
    
    /// Test 134: Identical pool key handling
    function test_EdgeCases_IdenticalPoolKeys() public {
        PoolKey memory identicalKey = PoolKey({
            currency0: currency0,
            currency1: currency1,
            fee: fee,
            tickSpacing: tickSpacing,
            hooks: IHooks(address(hook))
        });
        
        SwapParams memory params1 = _createValidSwapParams(-1000e18, true);
        SwapParams memory params2 = _createValidSwapParams(-1100e18, false);
        
        bytes32 orderId1 = hook.routeToVault(TRADER, defaultPoolKey, params1, "");
        bytes32 orderId2 = hook.routeToVault(TRADER, identicalKey, params2, "");
        
        assertTrue(orderId1 != bytes32(0));
        assertTrue(orderId2 != bytes32(0));
        assertTrue(orderId1 != orderId2);
    }
    
    /// Test 135: Currency address edge cases
    function test_EdgeCases_CurrencyAddressEdgeCases() public {
        // Test with address(0) currencies (should still work with mock)
        PoolKey memory zeroAddressKey = PoolKey({
            currency0: Currency.wrap(address(0)),
            currency1: Currency.wrap(address(1)),
            fee: fee,
            tickSpacing: tickSpacing,
