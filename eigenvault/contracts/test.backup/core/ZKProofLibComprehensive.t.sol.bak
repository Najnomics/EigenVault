// SPDX-License-Identifier: MIT
pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";
import {console} from "forge-std/console.sol";
import {ZKProofLib} from "../../src/core/ZKProofLib.sol";

/// @title ZKProofLibComprehensive
/// @notice Comprehensive test suite for ZKProofLib library covering all proof types and edge cases
contract ZKProofLibComprehensiveTest is Test {
    using ZKProofLib for ZKProofLib.MatchingProof;
    using ZKProofLib for ZKProofLib.PrivacyProof;
    using ZKProofLib for ZKProofLib.BatchProof;

    // Test constants
    bytes32 public constant TEST_ORDER_ID = keccak256("test_order_1");
    bytes32 public constant TEST_POOL_HASH = keccak256("test_pool");
    uint256 public constant TEST_AMOUNT = 1000e18;
    uint256 public constant TEST_PRICE = 1800e18;
    
    // Test operators
    address[] public operators;
    bytes32[] public commitments;
    
    // Events
    event ProofGenerated(
        bytes32 indexed proofId,
        address indexed operator,
        string proofType,
        uint256 timestamp
    );
    
    event ProofVerified(
        bytes32 indexed proofId,
        bool isValid,
        ZKProofLib.ProofError error
    );
    
    event BatchProofCreated(
        bytes32 indexed batchId,
        uint256 proofCount,
        address[] operators
    );

    function setUp() public {
        // Setup test operators
        operators = new address[](5);
        operators[0] = address(0x101);
        operators[1] = address(0x102);
        operators[2] = address(0x103);
        operators[3] = address(0x104);
        operators[4] = address(0x105);
        
        // Setup test commitments
        commitments = new bytes32[](3);
        commitments[0] = keccak256("commitment_1");
        commitments[1] = keccak256("commitment_2");
        commitments[2] = keccak256("commitment_3");
    }

    /*//////////////////////////////////////////////////////////////
                        MATCHING PROOF TESTS
    //////////////////////////////////////////////////////////////*/

    function test_generate_matching_proof_success() public view {
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        assertEq(proof.poolHash, TEST_POOL_HASH);
        assertEq(proof.orderCount, 1);
        assertGt(proof.publicInputs.length, 0);
        assertGt(proof.proof.length, 0);
        assertGt(proof.verificationKey.length, 0);
        assertEq(proof.operators.length, operators.length);
        assertEq(proof.timestamp, block.timestamp);
        assertTrue(proof.proofId != bytes32(0));
    }

    function test_generate_matching_proof_zero_order_id() public view {
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            bytes32(0),
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        // Should still generate proof but with zero order ID
        assertEq(proof.poolHash, TEST_POOL_HASH);
        assertTrue(proof.proofId != bytes32(0));
    }

    function test_generate_matching_proof_zero_amount() public view {
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            0,
            TEST_PRICE,
            operators
        );
        
        // Should generate proof with zero amount
        assertEq(proof.poolHash, TEST_POOL_HASH);
        assertTrue(proof.proofId != bytes32(0));
    }

    function test_generate_matching_proof_empty_operators() public view {
        address[] memory emptyOperators = new address[](0);
        
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            emptyOperators
        );
        
        assertEq(proof.operators.length, 0);
        assertTrue(proof.proofId != bytes32(0));
    }

    function test_verify_matching_proof_valid() public view {
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
            
        assertTrue(result.isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.None));
        assertEq(result.operators.length, operators.length);
        assertEq(result.proofTimestamp, block.timestamp);
    }

    function test_verify_matching_proof_wrong_pool_hash() public view {
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        bytes32 wrongPoolHash = keccak256("wrong_pool");
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, wrongPoolHash);
            
        assertFalse(result.isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.InvalidProof));
    }

    function test_verify_matching_proof_expired() public {
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        // Simulate time passing
        proof.timestamp = block.timestamp - 25 hours;
        
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
            
        assertFalse(result.isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.ProofExpired));
    }

    function test_verify_matching_proof_insufficient_operators() public view {
        address[] memory singleOperator = new address[](1);
        singleOperator[0] = operators[0];
        
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            singleOperator
        );
        
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
            
        assertFalse(result.isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.InsufficientOperators));
    }

    function test_verify_matching_proof_empty_proof_data() public view {
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        // Clear proof data
        proof.proof = "";
        
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
            
        assertFalse(result.isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.InvalidProof));
    }

    function test_verify_matching_proof_empty_verification_key() public view {
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        // Clear verification key
        proof.verificationKey = "";
        
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
            
        assertFalse(result.isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.InvalidVerificationKey));
    }

    function test_verify_matching_proof_empty_public_inputs() public view {
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        // Clear public inputs
        proof.publicInputs = new bytes32[](0);
        
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
            
        assertFalse(result.isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.InvalidPublicInputs));
    }

    /*//////////////////////////////////////////////////////////////
                        PRIVACY PROOF TESTS
    //////////////////////////////////////////////////////////////*/

    function test_generate_privacy_proof_success() public view {
        bytes32 validityHash = keccak256("validity_result");
        
        ZKProofLib.PrivacyProof memory proof = ZKProofLib.generatePrivacyProof(
            commitments,
            validityHash,
            operators[0]
        );
        
        assertEq(proof.commitments.length, commitments.length);
        assertEq(proof.validityHash, validityHash);
        assertEq(proof.operator, operators[0]);
        assertGt(proof.proof.length, 0);
        assertEq(proof.timestamp, block.timestamp);
        assertTrue(proof.proofId != bytes32(0));
    }

    function test_generate_privacy_proof_empty_commitments() public view {
        bytes32[] memory emptyCommitments = new bytes32[](0);
        bytes32 validityHash = keccak256("validity_result");
        
        ZKProofLib.PrivacyProof memory proof = ZKProofLib.generatePrivacyProof(
            emptyCommitments,
            validityHash,
            operators[0]
        );
        
        assertEq(proof.commitments.length, 0);
        assertEq(proof.validityHash, validityHash);
        assertTrue(proof.proofId != bytes32(0));
    }

    function test_generate_privacy_proof_zero_operator() public view {
        bytes32 validityHash = keccak256("validity_result");
        
        ZKProofLib.PrivacyProof memory proof = ZKProofLib.generatePrivacyProof(
            commitments,
            validityHash,
            address(0)
        );
        
        assertEq(proof.operator, address(0));
        assertTrue(proof.proofId != bytes32(0));
    }

    function test_verify_privacy_proof_valid() public view {
        bytes32 validityHash = keccak256("validity_result");
        
        ZKProofLib.PrivacyProof memory proof = ZKProofLib.generatePrivacyProof(
            commitments,
            validityHash,
            operators[0]
        );
        
        (bool isValid, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyPrivacyProof(proof, commitments);
            
        assertTrue(isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.None));
    }

    function test_verify_privacy_proof_wrong_commitments() public view {
        bytes32 validityHash = keccak256("validity_result");
        
        ZKProofLib.PrivacyProof memory proof = ZKProofLib.generatePrivacyProof(
            commitments,
            validityHash,
            operators[0]
        );
        
        bytes32[] memory wrongCommitments = new bytes32[](1);
        wrongCommitments[0] = keccak256("wrong_commitment");
        
        (bool isValid, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyPrivacyProof(proof, wrongCommitments);
            
        assertFalse(isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.InvalidProof));
    }

    function test_verify_privacy_proof_expired() public {
        bytes32 validityHash = keccak256("validity_result");
        
        ZKProofLib.PrivacyProof memory proof = ZKProofLib.generatePrivacyProof(
            commitments,
            validityHash,
            operators[0]
        );
        
        // Simulate time passing
        proof.timestamp = block.timestamp - 25 hours;
        
        (bool isValid, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyPrivacyProof(proof, commitments);
            
        assertFalse(isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.ProofExpired));
    }

    function test_verify_privacy_proof_empty_proof() public view {
        bytes32 validityHash = keccak256("validity_result");
        
        ZKProofLib.PrivacyProof memory proof = ZKProofLib.generatePrivacyProof(
            commitments,
            validityHash,
            operators[0]
        );
        
        proof.proof = "";
        
        (bool isValid, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyPrivacyProof(proof, commitments);
            
        assertFalse(isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.InvalidProof));
    }

    /*//////////////////////////////////////////////////////////////
                        BATCH PROOF TESTS
    //////////////////////////////////////////////////////////////*/

    function test_generate_batch_proof_success() public view {
        ZKProofLib.MatchingProof[] memory individualProofs = new ZKProofLib.MatchingProof[](3);
        
        for (uint i = 0; i < 3; i++) {
            individualProofs[i] = ZKProofLib.generateMatchingProof(
                keccak256(abi.encode("order", i)),
                TEST_POOL_HASH,
                TEST_AMOUNT + i * 100e18,
                TEST_PRICE + i * 50e18,
                operators
            );
        }
        
        ZKProofLib.BatchProof memory batchProof = ZKProofLib.generateBatchProof(
            individualProofs,
            operators
        );
        
        assertEq(batchProof.individualProofs.length, 3);
        assertEq(batchProof.totalMatches, 3);
        assertEq(batchProof.operators.length, operators.length);
        assertGt(batchProof.aggregatedProof.length, 0);
        assertTrue(batchProof.batchId != bytes32(0));
        assertTrue(batchProof.batchHash != bytes32(0));
    }

    function test_generate_batch_proof_empty_proofs() public view {
        ZKProofLib.MatchingProof[] memory emptyProofs = new ZKProofLib.MatchingProof[](0);
        
        ZKProofLib.BatchProof memory batchProof = ZKProofLib.generateBatchProof(
            emptyProofs,
            operators
        );
        
        assertEq(batchProof.individualProofs.length, 0);
        assertEq(batchProof.totalMatches, 0);
        assertTrue(batchProof.batchId != bytes32(0));
    }

    function test_generate_batch_proof_empty_operators() public view {
        ZKProofLib.MatchingProof[] memory individualProofs = new ZKProofLib.MatchingProof[](1);
        individualProofs[0] = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        address[] memory emptyOperators = new address[](0);
        ZKProofLib.BatchProof memory batchProof = ZKProofLib.generateBatchProof(
            individualProofs,
            emptyOperators
        );
        
        assertEq(batchProof.operators.length, 0);
        assertTrue(batchProof.batchId != bytes32(0));
    }

    function test_verify_batch_proof_valid() public view {
        ZKProofLib.MatchingProof[] memory individualProofs = new ZKProofLib.MatchingProof[](2);
        
        individualProofs[0] = ZKProofLib.generateMatchingProof(
            keccak256("order1"),
            TEST_POOL_HASH,
            1000e18,
            1800e18,
            operators
        );
        
        individualProofs[1] = ZKProofLib.generateMatchingProof(
            keccak256("order2"),
            TEST_POOL_HASH,
            1500e18,
            1850e18,
            operators
        );
        
        ZKProofLib.BatchProof memory batchProof = ZKProofLib.generateBatchProof(
            individualProofs,
            operators
        );
        
        (bool isValid, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyBatchProof(batchProof);
            
        assertTrue(isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.None));
    }

    function test_verify_batch_proof_insufficient_operators() public view {
        ZKProofLib.MatchingProof[] memory individualProofs = new ZKProofLib.MatchingProof[](1);
        individualProofs[0] = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        address[] memory singleOperator = new address[](1);
        singleOperator[0] = operators[0];
        
        ZKProofLib.BatchProof memory batchProof = ZKProofLib.generateBatchProof(
            individualProofs,
            singleOperator
        );
        
        (bool isValid, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyBatchProof(batchProof);
            
        assertFalse(isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.InsufficientOperators));
    }

    function test_verify_batch_proof_empty_aggregated_proof() public view {
        ZKProofLib.MatchingProof[] memory individualProofs = new ZKProofLib.MatchingProof[](1);
        individualProofs[0] = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        ZKProofLib.BatchProof memory batchProof = ZKProofLib.generateBatchProof(
            individualProofs,
            operators
        );
        
        batchProof.aggregatedProof = "";
        
        (bool isValid, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyBatchProof(batchProof);
            
        assertFalse(isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.InvalidProof));
    }

    /*//////////////////////////////////////////////////////////////
                        OPTIMIZED VERIFICATION TESTS
    //////////////////////////////////////////////////////////////*/

    function test_verify_optimized_batch_proof_success() public view {
        bytes memory aggregatedProof = abi.encode("optimized_batch_proof");
        bytes32 batchHash = keccak256("batch_hash");
        
        bool isValid = ZKProofLib.verifyOptimizedBatchProof(
            aggregatedProof,
            batchHash,
            operators
        );
        
        assertTrue(isValid);
    }

    function test_verify_optimized_batch_proof_empty_proof() public view {
        bytes32 batchHash = keccak256("batch_hash");
        
        bool isValid = ZKProofLib.verifyOptimizedBatchProof(
            "",
            batchHash,
            operators
        );
        
        assertFalse(isValid);
    }

    function test_verify_optimized_batch_proof_empty_operators() public view {
        bytes memory aggregatedProof = abi.encode("optimized_batch_proof");
        bytes32 batchHash = keccak256("batch_hash");
        address[] memory emptyOperators = new address[](0);
        
        bool isValid = ZKProofLib.verifyOptimizedBatchProof(
            aggregatedProof,
            batchHash,
            emptyOperators
        );
        
        assertFalse(isValid);
    }

    function test_verify_optimized_batch_proof_zero_batch_hash() public view {
        bytes memory aggregatedProof = abi.encode("optimized_batch_proof");
        
        bool isValid = ZKProofLib.verifyOptimizedBatchProof(
            aggregatedProof,
            bytes32(0),
            operators
        );
        
        assertFalse(isValid);
    }

    /*//////////////////////////////////////////////////////////////
                        RECURSIVE VERIFICATION TESTS
    //////////////////////////////////////////////////////////////*/

    function test_verify_recursive_proof_success() public view {
        bytes memory proof = abi.encode("recursive_proof");
        bytes32[] memory publicInputs = new bytes32[](2);
        publicInputs[0] = keccak256("input1");
        publicInputs[1] = keccak256("input2");
        bytes memory verificationKey = abi.encode("verification_key");
        
        bool isValid = ZKProofLib.verifyRecursiveProof(
            proof,
            publicInputs,
            verificationKey
        );
        
        assertTrue(isValid);
    }

    function test_verify_recursive_proof_empty_proof() public view {
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = keccak256("input1");
        bytes memory verificationKey = abi.encode("verification_key");
        
        bool isValid = ZKProofLib.verifyRecursiveProof(
            "",
            publicInputs,
            verificationKey
        );
        
        assertFalse(isValid);
    }

    function test_verify_recursive_proof_empty_inputs() public view {
        bytes memory proof = abi.encode("recursive_proof");
        bytes32[] memory emptyInputs = new bytes32[](0);
        bytes memory verificationKey = abi.encode("verification_key");
        
        bool isValid = ZKProofLib.verifyRecursiveProof(
            proof,
            emptyInputs,
            verificationKey
        );
        
        assertFalse(isValid);
    }

    function test_verify_recursive_proof_empty_key() public view {
        bytes memory proof = abi.encode("recursive_proof");
        bytes32[] memory publicInputs = new bytes32[](1);
        publicInputs[0] = keccak256("input1");
        
        bool isValid = ZKProofLib.verifyRecursiveProof(
            proof,
            publicInputs,
            ""
        );
        
        assertFalse(isValid);
    }

    /*//////////////////////////////////////////////////////////////
                        PRIVACY BATCH VERIFICATION TESTS
    //////////////////////////////////////////////////////////////*/

    function test_verify_privacy_batch_proof_success() public view {
        bytes32[] memory batchCommitments = new bytes32[](3);
        batchCommitments[0] = keccak256("commitment1");
        batchCommitments[1] = keccak256("commitment2");
        batchCommitments[2] = keccak256("commitment3");
        
        bytes memory batchProof = abi.encode("privacy_batch_proof");
        
        bool isValid = ZKProofLib.verifyPrivacyBatchProof(
            batchProof,
            batchCommitments,
            operators[0]
        );
        
        assertTrue(isValid);
    }

    function test_verify_privacy_batch_proof_empty_proof() public view {
        bytes32[] memory emptyCommitments = new bytes32[](1);
        emptyCommitments[0] = keccak256("commitment1");
        
        bool isValid = ZKProofLib.verifyPrivacyBatchProof(
            "",
            emptyCommitments,
            operators[0]
        );
        
        assertFalse(isValid);
    }

    function test_verify_privacy_batch_proof_empty_commitments() public view {
        bytes memory batchProof = abi.encode("privacy_batch_proof");
        bytes32[] memory emptyCommitments = new bytes32[](0);
        
        bool isValid = ZKProofLib.verifyPrivacyBatchProof(
            batchProof,
            emptyCommitments,
            operators[0]
        );
        
        assertFalse(isValid);
    }

    function test_verify_privacy_batch_proof_zero_operator() public view {
        bytes memory batchProof = abi.encode("privacy_batch_proof");
        bytes32[] memory zeroCommitments = new bytes32[](1);
        zeroCommitments[0] = keccak256("commitment1");
        
        bool isValid = ZKProofLib.verifyPrivacyBatchProof(
            batchProof,
            zeroCommitments,
            address(0)
        );
        
        assertFalse(isValid);
    }

    /*//////////////////////////////////////////////////////////////
                        PROOF ID GENERATION TESTS
    //////////////////////////////////////////////////////////////*/

    function test_generate_proof_id_unique() public view {
        bytes memory proofData1 = abi.encode("proof1");
        bytes memory proofData2 = abi.encode("proof2");
        
        bytes32 proofId1 = ZKProofLib.generateProofId(proofData1, block.timestamp, operators[0]);
        bytes32 proofId2 = ZKProofLib.generateProofId(proofData2, block.timestamp, operators[0]);
        
        assertTrue(proofId1 != proofId2);
    }

    function test_generate_proof_id_same_input() public view {
        bytes memory proofData = abi.encode("proof");
        uint256 timestamp = block.timestamp;
        address operator = operators[0];
        
        bytes32 proofId1 = ZKProofLib.generateProofId(proofData, timestamp, operator);
        bytes32 proofId2 = ZKProofLib.generateProofId(proofData, timestamp, operator);
        
        assertEq(proofId1, proofId2);
    }

    function test_generate_proof_id_different_timestamps() public view {
        bytes memory proofData = abi.encode("proof");
        address operator = operators[0];
        
        bytes32 proofId1 = ZKProofLib.generateProofId(proofData, block.timestamp, operator);
        bytes32 proofId2 = ZKProofLib.generateProofId(proofData, block.timestamp + 1, operator);
        
        assertTrue(proofId1 != proofId2);
    }

    function test_generate_proof_id_different_operators() public view {
        bytes memory proofData = abi.encode("proof");
        uint256 timestamp = block.timestamp;
        
        bytes32 proofId1 = ZKProofLib.generateProofId(proofData, timestamp, operators[0]);
        bytes32 proofId2 = ZKProofLib.generateProofId(proofData, timestamp, operators[1]);
        
        assertTrue(proofId1 != proofId2);
    }

    function test_generate_proof_id_empty_data() public view {
        bytes32 proofId = ZKProofLib.generateProofId("", block.timestamp, operators[0]);
        assertTrue(proofId != bytes32(0));
    }

    function test_generate_proof_id_zero_timestamp() public view {
        bytes memory proofData = abi.encode("proof");
        bytes32 proofId = ZKProofLib.generateProofId(proofData, 0, operators[0]);
        assertTrue(proofId != bytes32(0));
    }

    function test_generate_proof_id_zero_operator() public view {
        bytes memory proofData = abi.encode("proof");
        bytes32 proofId = ZKProofLib.generateProofId(proofData, block.timestamp, address(0));
        assertTrue(proofId != bytes32(0));
    }

    /*//////////////////////////////////////////////////////////////
                        CIRCUIT VALIDATION TESTS
    //////////////////////////////////////////////////////////////*/

    function test_validate_circuit_info_success() public view {
        ZKProofLib.CircuitInfo memory circuitInfo = ZKProofLib.CircuitInfo({
            circuitHash: keccak256("circuit"),
            verificationKey: abi.encode("vk"),
            maxOrders: 100,
            circuitType: "order_matching"
        });
        
        bool isValid = ZKProofLib.validateCircuitInfo(circuitInfo);
        assertTrue(isValid);
    }

    function test_validate_circuit_info_zero_hash() public view {
        ZKProofLib.CircuitInfo memory circuitInfo = ZKProofLib.CircuitInfo({
            circuitHash: bytes32(0),
            verificationKey: abi.encode("vk"),
            maxOrders: 100,
            circuitType: "order_matching"
        });
        
        bool isValid = ZKProofLib.validateCircuitInfo(circuitInfo);
        assertFalse(isValid);
    }

    function test_validate_circuit_info_empty_vk() public view {
        ZKProofLib.CircuitInfo memory circuitInfo = ZKProofLib.CircuitInfo({
            circuitHash: keccak256("circuit"),
            verificationKey: "",
            maxOrders: 100,
            circuitType: "order_matching"
        });
        
        bool isValid = ZKProofLib.validateCircuitInfo(circuitInfo);
        assertFalse(isValid);
    }

    function test_validate_circuit_info_zero_max_orders() public view {
        ZKProofLib.CircuitInfo memory circuitInfo = ZKProofLib.CircuitInfo({
            circuitHash: keccak256("circuit"),
            verificationKey: abi.encode("vk"),
            maxOrders: 0,
            circuitType: "order_matching"
        });
        
        bool isValid = ZKProofLib.validateCircuitInfo(circuitInfo);
        assertFalse(isValid);
    }

    function test_validate_circuit_info_empty_type() public view {
        ZKProofLib.CircuitInfo memory circuitInfo = ZKProofLib.CircuitInfo({
            circuitHash: keccak256("circuit"),
            verificationKey: abi.encode("vk"),
            maxOrders: 100,
            circuitType: ""
        });
        
        bool isValid = ZKProofLib.validateCircuitInfo(circuitInfo);
        assertFalse(isValid);
    }

    /*//////////////////////////////////////////////////////////////
                        PERFORMANCE TESTS
    //////////////////////////////////////////////////////////////*/

    function test_batch_proof_gas_efficiency() public view {
        ZKProofLib.MatchingProof[] memory individualProofs = new ZKProofLib.MatchingProof[](10);
        
        for (uint i = 0; i < 10; i++) {
            individualProofs[i] = ZKProofLib.generateMatchingProof(
                keccak256(abi.encode("order", i)),
                TEST_POOL_HASH,
                TEST_AMOUNT + i * 100e18,
                TEST_PRICE + i * 50e18,
                operators
            );
        }
        
        uint256 gasStart = gasleft();
        ZKProofLib.BatchProof memory batchProof = ZKProofLib.generateBatchProof(
            individualProofs,
            operators
        );
        uint256 gasUsed = gasStart - gasleft();
        
        // Batch proof generation should be reasonably efficient
        console.log("Batch proof generation gas used:", gasUsed);
        assertLt(gasUsed, 2000000); // Less than 2M gas
        
        // Verify the batch proof
        gasStart = gasleft();
        (bool isValid,) = ZKProofLib.verifyBatchProof(batchProof);
        gasUsed = gasStart - gasleft();
        
        assertTrue(isValid);
        console.log("Batch proof verification gas used:", gasUsed);
        assertLt(gasUsed, 1000000); // Less than 1M gas for verification
    }

    function test_individual_proof_gas_efficiency() public view {
        uint256 gasStart = gasleft();
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        uint256 gasUsed = gasStart - gasleft();
        
        console.log("Individual proof generation gas used:", gasUsed);
        assertLt(gasUsed, 500000); // Less than 500k gas
        
        gasStart = gasleft();
        (bool isValid,) = ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
        gasUsed = gasStart - gasleft();
        
        assertTrue(isValid);
        console.log("Individual proof verification gas used:", gasUsed);
        assertLt(gasUsed, 200000); // Less than 200k gas for verification
    }

    /*//////////////////////////////////////////////////////////////
                        EDGE CASE TESTS
    //////////////////////////////////////////////////////////////*/

    function test_maximum_operators() public view {
        // Test with maximum number of operators
        address[] memory maxOperators = new address[](100);
        for (uint i = 0; i < 100; i++) {
            maxOperators[i] = address(uint160(i + 1));
        }
        
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            maxOperators
        );
        
        assertEq(proof.operators.length, 100);
        
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
            
        assertTrue(result.isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.None));
    }

    function test_maximum_commitments() public view {
        // Test with maximum number of commitments
        bytes32[] memory maxCommitments = new bytes32[](100);
        for (uint i = 0; i < 100; i++) {
            maxCommitments[i] = keccak256(abi.encode("commitment", i));
        }
        
        bytes32 validityHash = keccak256("validity_result");
        ZKProofLib.PrivacyProof memory proof = ZKProofLib.generatePrivacyProof(
            maxCommitments,
            validityHash,
            operators[0]
        );
        
        assertEq(proof.commitments.length, 100);
        
        (bool isValid, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyPrivacyProof(proof, maxCommitments);
            
        assertTrue(isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.None));
    }

    function test_extreme_amounts_and_prices() public view {
        // Test with maximum uint256 values
        uint256 maxAmount = type(uint256).max;
        uint256 maxPrice = type(uint256).max;
        
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            maxAmount,
            maxPrice,
            operators
        );
        
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
            
        assertTrue(result.isValid);
        assertEq(uint(error), uint(ZKProofLib.ProofError.None));
    }

    function test_boundary_timestamps() public {
        // Test at exactly 24 hour boundary
        ZKProofLib.MatchingProof memory proof = ZKProofLib.generateMatchingProof(
            TEST_ORDER_ID,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        // Set timestamp to exactly 24 hours ago
        proof.timestamp = block.timestamp - 24 hours;
        
        (ZKProofLib.ProofResult memory result, ZKProofLib.ProofError error) = 
            ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
            
        assertTrue(result.isValid); // Should still be valid at exactly 24 hours
        assertEq(uint(error), uint(ZKProofLib.ProofError.None));
        
        // Set timestamp to just over 24 hours ago
        proof.timestamp = block.timestamp - 24 hours - 1;
        
        (result, error) = ZKProofLib.verifyMatchingProof(proof, TEST_POOL_HASH);
        
        assertFalse(result.isValid); // Should be expired now
        assertEq(uint(error), uint(ZKProofLib.ProofError.ProofExpired));
    }

    function test_concurrent_proof_generation() public view {
        // Simulate concurrent proof generation with same parameters
        bytes32 orderId = keccak256("concurrent_order");
        
        ZKProofLib.MatchingProof memory proof1 = ZKProofLib.generateMatchingProof(
            orderId,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        ZKProofLib.MatchingProof memory proof2 = ZKProofLib.generateMatchingProof(
            orderId,
            TEST_POOL_HASH,
            TEST_AMOUNT,
            TEST_PRICE,
            operators
        );
        
        // Proofs should be identical if generated with same parameters in same block
        assertEq(proof1.proofId, proof2.proofId);
        assertEq(proof1.poolHash, proof2.poolHash);
        assertEq(proof1.timestamp, proof2.timestamp);
    }
}